# Copy to .env after auditing the target. No directory is created by Compose.
MUSIC_UID=1000
MUSIC_GID=1000
NAVIDROME_PORT=4534
# Examples only. NAVIDROME_DATA must be a newly restored copy, never the live data.
NAVIDROME_DATA=/path/to/home-music/preview/data
MUSIC_LIBRARY=/path/to/existing/navidrome/music
