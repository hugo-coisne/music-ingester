# Copy to .env after auditing the target. No directory is created by Compose.
MUSIC_UID=1000
MUSIC_GID=1000
NAVIDROME_PORT=4534
# Examples only. NAVIDROME_DATA must be a newly restored copy, never the live data.
NAVIDROME_DATA=/path/to/home-music/preview/data
MUSIC_LIBRARY=/path/to/existing/navidrome/music

# Independent one-shot worker, compose.watch.yml. Pin a tested Docker image ID.
WATCH_IMAGE=
WATCH_ROOT=/path/to/home-music/automation
MUSIC_ROOT=/path/to/existing/navidrome/music
MANAGED_MUSIC_ROOT=/path/to/existing/navidrome/music/Managed Singles
# Read-only catalog; distinct from NAVIDROME_DATA to protect the parallel server.
WATCH_NAVIDROME_DATA=/path/to/existing/navidrome/data
