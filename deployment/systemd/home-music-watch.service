[Unit]
Description=Import monitored music playlists and synchronize Navidrome mirrors
# User managers do not provide the system network-online.target. Network failures
# are reported by the bounded adapters and retried by the next timer invocation.

[Service]
Type=oneshot
# Replace @WATCH_ROOT@ when installing. This is a user unit.
WorkingDirectory=@WATCH_ROOT@
ExecStart=/usr/bin/docker compose --env-file .env -f compose.watch.yml run --rm --name home-music-watch-worker watch
ExecStopPost=-/usr/bin/docker stop --time 30 home-music-watch-worker
TimeoutStartSec=60min
TimeoutStopSec=60
UMask=0077
Nice=10

[Install]
WantedBy=default.target
